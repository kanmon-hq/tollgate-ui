# Tollgate UI — Environment Variables
# API Gateway / Tollgate バックエンド接続先 URL
# ※ 開発時は空文字（未指定）にすることで Vite プロキシ経由で http://localhost:8000 にルーティングされ、CORSエラーを回避できます。
# ※ Nginx 経由や本番環境では https://api.example.com や /api/tollgate などを指定してください。
VITE_TOLLGATE_API_BASE_URL=

# 管理者マスターキー (Tollgate 本体の ADMIN_API_KEY)
VITE_TOLLGATE_ADMIN_TOKEN=
